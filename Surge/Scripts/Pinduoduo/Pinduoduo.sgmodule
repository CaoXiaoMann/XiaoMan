[Body Rewrite]
http-response-jq (?i)^https://api\.pinduoduo\.com/api/alexa/homepage/hub\? 'delpaths([["result","icon_set"], ["result","search_bar_hot_query"], ["result","dy_module","irregular_banner_dy"]])'
http-response-jq (?i)^https://api\.pinduoduo\.com/api/alexa/homepage/hub\? '.result.bottom_tabs? |= map(select(.link | IN("index.html","chat_list.html","personal.html"))) | .result.buffer_bottom_tabs? |= map(select(.link | IN("index.html","chat_list.html","personal.html"))) | .result.all_top_opts = [] | .result.module_order? |= map(select(.module_name | IN("irregular_banner","ad_module","timeline") | not))'
http-response-jq (?i)^https://api\.pinduoduo\.com/search\? 'delpaths([["expansion"]])'
http-response-jq (?i)^https://api\.pinduoduo\.com/api/philo/personal/hub\? 'delpaths([["monthly_card_entrance"], ["personal_center_style_v2_vo"], ["icon_set","icons"], ["icon_set","top_personal_icons"], ["title_bar_items"], ["personal_banner"]])'
http-response-jq (?i)^https://api\.pinduoduo\.com/api/oak/integration/render\? 'delpaths([["bottom_section_list"], ["ui","bottom_section"], ["ui","live_section","float_info"]])'
http-response-jq (?i)^https://api\.pinduoduo\.com/order/ 'delpaths([["marketing_banner_vo"], ["shipping","banner_above_recommend"]])'
http-response-jq (?i)^https://api\.pinduoduo\.com/api/aristotle/order_list_v4\? '.orders |= map(.order_buttons |= map(del(.order_growth_tip)))'

[Script]
plugin_1 = type=http-response, pattern=(?i)^https://m\.pinduoduo\.net/comment_result\.html\?, script-path=https://rucu6.pages.dev/Scripts/pinduoduo.js, requires-body=true, timeout=10
plugin_2 = type=http-response, pattern=(?i)^https://m\.pinduoduo\.net/mdkd/package\?, script-path=https://rucu6.pages.dev/Scripts/pinduoduo.js, requires-body=true, timeout=10

[MITM]
hostname = %APPEND% api.pinduoduo.com, api.yangkeduo.com, m.pinduoduo.net
