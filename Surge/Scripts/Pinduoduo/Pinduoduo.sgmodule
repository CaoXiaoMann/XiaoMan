#!name=拼多多去广告
#!desc=移除开屏广告、底栏多多视频、会场入口、聊天页面精选推荐及推广，精简首页和个人中心。
#!author=ZenmoFeiShi[https://github.com/ZenmoFeiShi], 可莉🅥[https://github.com/luestr/ProxyResource/blob/main/README.md]
#!icon=https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/PinDuoDuo.png
#!category=XiaoMan
#!openUrl=https://apps.apple.com/app/id1044283059
#!tag=去广告
#!homepage=https://hub.kelee.one
#!date=2026-02-28 20:52:18

[Rule]
# > IP 直连广告接口兜底（下拉刷新走缓存IP直连，SNI=域名，extended-matching 用SNI匹配；Body Rewrite/Map Local 只匹配请求行URL匹配不到IP）
URL-REGEX,"^https?:\/\/(((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)|[a-z0-9.-]*pinduoduo\.com|[a-z0-9.-]*yangkeduo\.com)(\/api)?\/(cappuccino/splash|alexa/cells/hub|alexa/goods/back_up|aquarius/hungary/global/homepage|brand\-olay/goods_detail/bybt_guide|buffon/nasus/recommend|caterham/v3/query/order_express_group|caterham/v3/query/new_chat_group|caterham/v3/query/personal|caterham/v3/query/my_order_group|caterham/v3/query/likes|dunkirk/subaru/goods_list_v2|dunkirk/liveactivity/push/create/url/report|engels/reviews/require/append|engels/wait/receive/review|express/post/landing_page/ad/recommend_goods_list/pickup_identity_code|flow/hungary/window/global/v2|growth/nagato/app/index/gather|manufacturer/cross/shortcut/list|phantom/gbdbpdv/extra|xrec/goods_rec/pay_after_use_v2|zaire_biz/chat/resource/get_list_data|light/live_tab/query/live_red_dot|search_hotquery)([\/?#]|$)",REJECT,pre-matching,extended-matching
AND,((URL-REGEX,"^http:\/\/((25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\.){3}(25[0-5]|2[0-4][0-9]|[01]?[0-9][0-9]?)\/d(\d)?",extended-matching),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
AND,((URL-REGEX,"^http:\/\/\[[0-9a-fA-F:]+\]\/d(\d)?\?",extended-matching),(USER-AGENT,"*com.xunmeng.pinduoduo*")),REJECT
AND,((DOMAIN,api.pinduoduo.com,extended-matching),(PROTOCOL,QUIC)),REJECT
# > 监控/埋点域名：只拦埋点路径（t.gif/te.gif/pmm/defined 等），保留正经 API（homepage/hub 等走 Body Rewrite 删字段）
URL-REGEX,"^https?:\/\/((?:[a-z0-9-]+\.)*pinduoduo\.com)(\/(?:t|te)\.gif|\/api\/pmm\/(?:defined|front_err))([\/?#]|$)",REJECT,extended-matching
URL-REGEX,"^https?:\/\/((?:[a-z0-9-]+\.)*yangkeduo\.com)(\/(?:t|te)\.gif|\/api\/pmm\/(?:defined|front_err))([\/?#]|$)",REJECT,extended-matching
URL-REGEX,"^https?:\/\/(?:titan|xg)\.pinduoduo\.com([\/?#]|$)",REJECT,extended-matching

[Body Rewrite]
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? 'delpaths([["result","dy_module","irregular_banner_dy"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? 'delpaths([["result","icon_set"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? 'delpaths([["result","search_bar_hot_query"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? 'delpaths([["result","dy_module","irregular_banner_dy"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/alexa\/homepage\/hub\? '.result.bottom_tabs? |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) | .result.buffer_bottom_tabs? |= map(select(.link | IN("index.html", "chat_list.html", "personal.html"))) | .result.all_top_opts |= map(del(.selected_image, .image, .height, .width))'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/search\? 'delpaths([["expansion"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/philo\/personal\/hub\? 'delpaths([["monthly_card_entrance"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/philo\/personal\/hub\? 'delpaths([["personal_center_style_v2_vo"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/philo\/personal\/hub\? 'delpaths([["icon_set","icons"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/philo\/personal\/hub\? 'delpaths([["icon_set","top_personal_icons"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/oak\/integration\/render\? 'delpaths([["bottom_section_list"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/oak\/integration\/render\? 'delpaths([["ui","bottom_section"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/oak\/integration\/render\? 'delpaths([["ui","live_section"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_detail_group\? 'delpaths([["data","goods_list"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/order\/ 'delpaths([["marketing_banner_vo"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/order\/ 'delpaths([["shipping","banner_above_recommend"]])'
http-response-jq ^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/aristotle\/order_list_v4\? '.orders |= map(.order_buttons |= map(del(.order_growth_tip)))'

[URL Rewrite]
# > IP直连API重写为域名（MITM已解密IP，URL Rewrite可处理；重写后Body Rewrite/Map Local域名pattern才匹配）
^https:\/\/(?:183\.194\.214\.\d+|81\.69\.104\.\d+|114\.110\.(?:9[6-9])\.\d+|117\.185\.(?:24[2-4])\.\d+|36\.152\.4[6-9]\.\d+)((?:\/api)?\/[^?#]*)(\?[^#]*)? https:\/\/meta\.pinduoduo\.com$1$2 header

[Map Local]
^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/aristotle\/unrated_order_for_unreceived_tab\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/aristotle\/query_order_list_tabs_element\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/aquarius\/hungary\/global\/homepage\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/caterham\/v3\/query\/order_express_group\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/search_hotquery\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/zaire_biz\/chat\/resource\/get_list_data\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/caterham\/v3\/query\/new_chat_group\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/alexa\/goods\/back_up\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/caterham\/v3\/query\/personal\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/brand-olay\/goods_detail\/bybt_guide\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/engels\/reviews\/require\/append\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/caterham\/v3\/query\/my_order_group\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/caterham\/v3\/query\/likes\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/phantom\/gbdbpdv\/extra\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/manufacturer\/cross\/shortcut\/list\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/dunkirk\/liveactivity\/push\/create\/url\/report\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/engels\/wait\/receive\/review\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

^https:\/\/(?:api|meta)\.pinduoduo\.com\/api\/buffon\/nasus\/recommend\? data-type=text data="{}" status-code=200 header="Content-Type:application/json"

[MITM]
hostname = %APPEND% api.pinduoduo.com, meta.pinduoduo.com

