#!name=黑料网去广告
#!desc=去除黑料网页面广告/横幅/浮层（含添加到主屏幕横幅），支持 heiliao.com 与 18hlw.com
#!category=XiaoMan
#!system=iOS
#!raw-url=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao/HeiLiao.sgmodule
#!date=2026-11-05
# 修正版：原模块只匹配 18hlw.com，用户实际访问 heiliao.com 导致 web.js 不生效

[MITM]
hostname = %APPEND% heiliao.com, *.heiliao.com, 18hlw.com, *.18hlw.com, api*.hlwapi*.com

[Script]
黑料网页去广告 = type=http-response,pattern=^https?:\/\/(heiliao\.com|18hlw\.com|www\.heiliao\.com|www\.18hlw\.com)\/.*$,script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao/web-v2.js,requires-body=1,max-size=5242880,timeout=30
黑料App去广告 = type=http-response,pattern=^https:\/\/api(\d+)?\.hlwapi(\d+)?\.com\/api\.php\/api\/index\/(config|userInfo|index|detail),script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao/app.js,requires-body=1,max-size=-1,timeout=30
