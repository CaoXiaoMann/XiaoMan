#!name=车来了banner定位
#!desc=临时定位 banner 数据源接口，定位后删除
#!author=CaoXiaoMann
#!category=XiaoMan

[Script]
cll-banner = type=http-response,pattern=^https?:\/\/[a-zA-Z0-9.-]*chelaile[a-zA-Z0-9.-]*\.cn\/,requires-body=true,script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/CheLaiLe/cll_banner_finder.js,timeout=10

[MITM]
hostname = %APPEND% cdn.api.chelaileapp.cn, api.chelaile.net.cn, cdn.api.chelaile.net.cn
