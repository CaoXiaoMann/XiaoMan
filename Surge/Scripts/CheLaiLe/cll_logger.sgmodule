#!name=车来了接口日志
#!desc=临时定位 banner 接口，定位后删除
#!author=CaoXiaoMann
#!category=XiaoMan

[Script]
cll-log = type=http-request,pattern=^https?:\/\/[a-zA-Z0-9.-]*chelaile[a-zA-Z0-9.-]*\.cn\/,script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/CheLaiLe/cll_logger.js,timeout=10

[MITM]
hostname = %APPEND% cdn.api.chelaileapp.cn, api.chelaile.net.cn, cdn.api.chelaile.net.cn
