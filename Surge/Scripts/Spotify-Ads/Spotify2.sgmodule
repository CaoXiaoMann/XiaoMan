#!name=Spotify 去广告
#!desc=转自 devchristian1337/loon-plugins(2026-10-08)：去广告 + 解锁高级功能 + 屏蔽 Spotify QUIC(修复随机切歌)。启用后请重登 Spotify。
#!author=小龙女她爸

[Rule]
# 对应 lpx 的 AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,QUIC)),REJECT
# Surge/Egern 的 protocol 只支持 UDP；QUIC 跑在 UDP 上，拒掉即逼音频回落 TCP
AND,((DOMAIN-SUFFIX,spotify.com),(PROTOCOL,UDP)),REJECT
DOMAIN,aet.spotify.com,REJECT

[Header Rewrite]
http-request ^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/user-customization-service\/v1\/customize header-del if-none-match

[MITM]
hostname = %APPEND% spclient.wg.spotify.com, *spclient.spotify.com

[Script]
# gabo：直接返回空响应
spotify-gabo = type=http-request,pattern=^https:\/\/(.*-spclient\.spotify\.com(:443)?|spclient\.wg\.spotify\.com)\/gabo-receiver-service,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-gabo.js
# 以下四条对应 lpx 的 reject-dict：返回 200 空 JSON
spotify-reject-pendragon = type=http-request,pattern=^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/pendragon,script-path=https://raw.githubusercontent.com/SIJULY/egern-radar/main/spotify/spot-reject-dict.js
spotify-reject-discovery = type=http-request,pattern=^https:\/\/(spclient\.wg|.*-spclient)\.spotify\.com(:443)?\/watch-feed-entrypoints\/v.\/discovery-from-seed,script-path=https://raw.githubusercontent.com/SIJULY/egern-radar/main/spotify/spot-reject-dict.js
spotify-reject-pam = type=http-request,pattern=^https:\/\/.*-spclient\.spotify\.com(:443)?\/pam-view-service\/,script-path=https://raw.githubusercontent.com/SIJULY/egern-radar/main/spotify/spot-reject-dict.js
spotify-reject-aidj = type=http-request,pattern=37i9dQZF1EYkqdzj48dyYq,script-path=https://raw.githubusercontent.com/SIJULY/egern-radar/main/spotify/spot-reject-dict.js
# 去广告（protobuf 二进制补丁）
spotify-nosearchad = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/browsita\/v.\/browse,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-NoSearchAd.js
spotify-nohomead = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/casita\/v.\/home\/,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-NoHomeAd.js
spotify-noscrollad = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/scrollsita\/v.\/scroll\/spotify,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-NoScrollAd.js
# 解锁高级功能（本地 protobuf 补丁，作者推荐；远程版按作者要求不启用）
spotify-proto = type=http-response,pattern=^https:\/\/(spclient\.wg\.spotify\.com|.*-spclient\.spotify\.com(:443)?)\/(bootstrap\/v1\/bootstrap|user-customization-service\/v1\/customize)(\?.*)?$,requires-body=1,binary-body-mode=1,script-path=https://raw.githubusercontent.com/devchristian1337/loon-plugins/refs/heads/main/Scripts/Spotify/spot-proto-ev3.js
