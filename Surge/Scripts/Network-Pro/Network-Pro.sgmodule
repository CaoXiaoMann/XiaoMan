#!name=网络诊断雷达
#!desc=本地网络 + 当前代理（出口/位置/ISP/纯净度/延迟/NAT）检测面板（移植自 Egern Network-Pro）
#!category=XiaoMan
#!system=iOS
#!raw-url=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/Network-Pro/Network-Pro.sgmodule
#!date=2026-11-05
#!arguments=YS:0,POLICY:-,XY:-
#!arguments-desc=YS:1打码IP; POLICY:策略组(-不指定); XY:协议

[Panel]
NetworkPro = title="网络诊断雷达",content="正在检测...",style=info,script-name=network-pro,update-interval=60

[Script]
network-pro = type=generic,script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/Network-Pro/Network-Pro-v5.js,argument=YS={{{YS}}}&POLICY={{{POLICY}}}&XY={{{XY}}},timeout=30
