[MITM]
hostname = %APPEND% api*.hlwapi*.com

[Script]
黑料Debug = type=http-response,pattern=^https:\/\/api(\d+)?\.hlwapi(\d+)?\.com\/api\.php\/api\/index\/(config|userInfo|index|detail),script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao-debug/heiliao_debug.js,requires-body=1,max-size=-1,timeout=30
