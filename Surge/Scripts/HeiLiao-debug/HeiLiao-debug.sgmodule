#!name=黑料诊断修复
#!desc=诊断黑料网页横幅并直接注入去横幅CSS（测试用）
#!category=XiaoMan
#!system=iOS
#!raw-url=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao-debug/HeiLiao-debug.sgmodule
#!date=2026-11-05

[MITM]
hostname = %APPEND% heiliao.com, *.heiliao.com, 18hlw.com, *.18hlw.com

[Script]
诊断修复 = type=http-response,pattern=heiliao\.com|18hlw\.com,script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao-debug/heiliao_diag_fix.js,requires-body=1,max-size=5242880,timeout=30
