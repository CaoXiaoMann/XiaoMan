#!name=黑料抓包临时
#!desc=临时抓包黑料网页+App接口广告字段（定位后删除）
#!category=XiaoMan
#!system=iOS
#!raw-url=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao-debug/HeiLiao-debug.sgmodule
#!date=2026-11-05

[MITM]
hostname = %APPEND% heiliao.com, *.heiliao.com, 18hlw.com, *.18hlw.com, api*.hlwapi*.com

[Script]
网页抓包 = type=http-response,pattern=heiliao\.com|18hlw\.com,script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao-debug/heiliao_web_debug-v3.js,requires-body=1,max-size=5242880,timeout=30
App抓包 = type=http-response,pattern=hlwapi.*api\.php\/api\/index\/(config|userInfo|index|detail),script-path=https://raw.githubusercontent.com/CaoXiaoMann/XiaoMan/main/Surge/Scripts/HeiLiao-debug/heiliao_debug-v2.js,requires-body=1,max-size=-1,timeout=30
