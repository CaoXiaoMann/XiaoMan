[Rewrite]
^https?:\/\/(homefront|qde|qbi)\.qunar\.com\/(.*) reject
^https?:\/\/sofire\.baidu\.com\/(.*) reject
^https?:\/\/ido\.gepush\.com(\/|$)(.*) reject
^https?:\/\/diplomat\.qunar\.com\/(.*) reject
^https?:\/\/hotfix\.qunar\.com\/(.*) reject
^https?:\/\/log2\.cmpassport\.com(\/|$)(.*) reject

[MITM]
hostname = %APPEND% homefront.qunar.com, qde.qunar.com, qbi.qunar.com, sofire.baidu.com, ido.gepush.com, diplomat.qunar.com, hotfix.qunar.com, log2.cmpassport.com